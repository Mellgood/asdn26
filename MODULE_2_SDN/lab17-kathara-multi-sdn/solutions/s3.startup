# s3 — SDN Switch (Lab 17 Solution)
/etc/init.d/openvswitch-switch start

ovs-vsctl add-br s3
ovs-vsctl add-port s3 eth0
ovs-vsctl add-port s3 eth1

# Management interface (pre-configured, NOT part of the OVS bridge)
ip addr add 172.16.0.30/24 dev eth2

# Connect to the Ryu controller on the management network
ovs-vsctl set-controller s3 tcp:172.16.0.1:6653
