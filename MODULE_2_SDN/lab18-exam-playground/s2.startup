# s2 — Access SDN Switch
# Data ports: eth0 → s1 (trunk), eth1 → h2 (web), eth2 → h3 (db)
# Management:  eth3 → controller (NOT added to the OVS bridge)

/etc/init.d/openvswitch-switch start

ovs-vsctl add-br s2

ovs-vsctl add-port s2 eth0
ovs-vsctl add-port s2 eth1
ovs-vsctl add-port s2 eth2

# Management interface — gives s2 IP connectivity to the controller
# This interface is NOT part of the OVS bridge (it's for control-plane only)
ip addr add 172.16.0.20/24 dev eth3

# Connect to the Ryu controller on the management network
ovs-vsctl set-controller s2 tcp:172.16.0.1:6653
