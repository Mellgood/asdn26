# s2 — Access SDN Switch
# Ports: eth0 → s1 (trunk), eth1 → h2 (web), eth2 → h3 (db)

/etc/init.d/openvswitch-switch start

ovs-vsctl add-br s2

ovs-vsctl add-port s2 eth0
ovs-vsctl add-port s2 eth1
ovs-vsctl add-port s2 eth2

# Connect to the same Ryu controller as s1
# Replace <CONTROLLER_IP> with your host machine's IP address
ovs-vsctl set-controller s2 tcp:<CONTROLLER_IP>:6653
