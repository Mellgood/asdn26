# SDN Switch 1 Boot Script

# Example provided: Starts the Open vSwitch background daemon (Required once per boot in Kathará)
/etc/init.d/openvswitch-switch start

# TODO: Create the OVS bridge named 's1' (Recall Lab 03: ovs-vsctl add-br ...)
# ...

# TODO: Add both of the physical Kathará interfaces 'eth0' and 'eth1' to the 's1' switch
# ...

# Management interface — gives s1 IP connectivity to the controller
# This interface is NOT part of the OVS bridge (it's for control-plane only)
ip addr add 172.16.0.10/24 dev eth2

# Connect to the Ryu controller on the management network
ovs-vsctl set-controller s1 tcp:172.16.0.1:6653
